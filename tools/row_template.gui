				# @COMMENT@
				hbox = {
					name = "tnt_ga_grade_@SIDE@"
					# Only one trait icon is visible; hidden ones must not take space.
					ignoreinvisible = yes
					min_height = 26
					spacing = 4
					alwaystransparent = no
					visible = "[And( And( @PICK@, @GATE@ ), GreaterThan_CFixedPoint( @S@.ScriptValue('tnt_ga_available_value'), '(CFixedPoint)0' ) )]"

					text_single = {
						align = left|nobaseline
						using = Font_Size_Medium
						alwaystransparent = yes
						raw_text = "#low GCA#! [@S@.ScriptValue('tnt_ga_chance_value')|0]%"
					}
					# Gap between the score and the trait icon.
					widget = {
						size = { 8 26 }
						alwaystransparent = yes
					}
					# Projected education trait icon (one per trait; only the match shows).
					widget = {
						size = { 26 26 }
						alwaystransparent = yes
@TRAIT_ICONS@
					}
					text_single = {
						align = left|nobaseline
						using = Font_Size_Medium
						alwaystransparent = yes
						visible = "[Not( GreaterThan_CFixedPoint( @S@.ScriptValue('tnt_ga_has_focus_value'), '(CFixedPoint)0' ) )]"
						raw_text = "#low ?#!"
					}

					using = tooltip_ne
					tooltipwidget = {
						widget = {
							using = DefaultTooltipBackground
							alwaystransparent = no

							vbox = {
								set_parent_size_to_minimum = yes
								ignoreinvisible = yes
								margin = { 20 10 }
								spacing = 4

								text_label_left = {
									layoutpolicy_horizontal = expanding
									raw_text = "[Localize('tnt_ga_tt_title')]: [@S@.ScriptValue('tnt_ga_chance_value')|0]%"
									default_format = "#T"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									raw_text = "#low [Localize('tnt_ga_tt_weights')] [@S@.ScriptValue('tnt_ga_success_weight_value')|1] / [@S@.ScriptValue('tnt_ga_failure_weight_value')|1]#!"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "tnt_ga_tt_success_header"
									default_format = "#P"
								}
								widget_value_breakdown_list = {
									datacontext = "[@S@.GetScriptValueBreakdown('tnt_ga_success_weight_value')]"
									blockoverride "background" {}
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "tnt_ga_tt_failure_header"
									default_format = "#N"
								}
								widget_value_breakdown_list = {
									datacontext = "[@S@.GetScriptValueBreakdown('tnt_ga_failure_weight_value')]"
									blockoverride "background" {}
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									raw_text = "[Localize('tnt_ga_tt_projection')] #V [@S@.ScriptValue('tnt_ga_projected_points_value')|1]#! (~[Localize('tnt_ga_tt_rank')] [@S@.ScriptValue('tnt_ga_projected_rank_value')|0])"
									default_format = "#P"
								}
								widget_value_breakdown_list = {
									datacontext = "[@S@.GetScriptValueBreakdown('tnt_ga_projected_points_value')]"
									blockoverride "background" {}
								}
								# Projected trait: icon + name (one per trait; only the match shows).
								widget = {
									size = { 420 30 }
@TRAIT_LINES@
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[Not( GreaterThan_CFixedPoint( @S@.ScriptValue('tnt_ga_has_focus_value'), '(CFixedPoint)0' ) )]"
									raw_text = "#low [Localize('tnt_ga_tt_no_focus')] #V [Localize( Select_CString( EqualTo_CFixedPoint( @S@.ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)1' ), 'education_diplomacy', Select_CString( EqualTo_CFixedPoint( @S@.ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)2' ), 'education_martial', Select_CString( EqualTo_CFixedPoint( @S@.ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)3' ), 'education_stewardship', Select_CString( EqualTo_CFixedPoint( @S@.ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)4' ), 'education_intrigue', 'education_learning' ) ) ) ) )]#!#!"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( @S@.ScriptValue('tnt_ga_storyteller_note_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_storyteller"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( @S@.ScriptValue('tnt_ga_beacon_note_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_beacon"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( @S@.ScriptValue('tnt_ga_note_pedagogy_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_pedagogy"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( @S@.ScriptValue('tnt_ga_note_commander_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_commander"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( @S@.ScriptValue('tnt_ga_note_knighthood_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_knighthood"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( @S@.ScriptValue('tnt_ga_note_faith_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_faith"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( @S@.ScriptValue('tnt_ga_note_culture_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_culture"
								}

								textbox = {
									layoutpolicy_horizontal = expanding
									margin_top = 4
									margin_bottom = 8
									max_width = 420
									autoresize = yes
									multiline = yes
									using = DefaultTooltipText
									text = "tnt_ga_tt_help"
									default_format = "#low"
								}
							}
						}
					}
				}
