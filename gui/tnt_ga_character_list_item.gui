											visible = "[EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)2' )]"
											datacontext = "[GetTrait( 'education_martial_3' )]"
