########################################################################
# Guardian Calculation Assistant 1.0
#
# Derived row for the generic interaction list. The vanilla/TC
# widget_character_list_item stays untouched; this type inherits whatever
# the playset supplies and only fills its character_relation block.
# Scores show only in Educate Child, Offer Guardianship, Offer Ward and
# the GCA guardian search, identified by their secondary-character
# labels, and only when the other slot holds the matching adult/child.
########################################################################

types TntGuardianAssistant
{
	type tnt_ga_widget_character_list_item = widget_character_list_item {
		blockoverride "character_relation" {
			hbox = {
				name = "tnt_ga_grade_and_relation"
				ignoreinvisible = yes
				layoutpolicy_horizontal = expanding
				min_height = 26
				spacing = 6

				# Vanilla, picking the secondary actor: the other pair member is the secondary recipient.
				hbox = {
					name = "tnt_ga_grade_a"
					min_height = 26
					spacing = 4
					alwaystransparent = no
					visible = "[And( And( CharacterInteractionConfirmationWindow.IsPickingSecondaryActor, Or( Or( EqualTo_string( CharacterInteractionConfirmationWindow.GetActorSecondaryLabel, Localize('actor_secondary_educate_child_interaction') ), EqualTo_string( CharacterInteractionConfirmationWindow.GetActorSecondaryLabel, Localize('actor_secondary_offer_guardianship_interaction') ) ), EqualTo_string( CharacterInteractionConfirmationWindow.GetRecipientSecondaryLabel, Localize('recipient_secondary_offer_ward_interaction') ) ) ), GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_available_value'), '(CFixedPoint)0' ) )]"

					text_single = {
						align = left|nobaseline
						using = Font_Size_Medium
						alwaystransparent = yes
						raw_text = "#low GCA#! [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_chance_value')|0]%"
					}
					text_single = {
						align = left|nobaseline
						using = Font_Size_Medium
						alwaystransparent = yes
						visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_has_focus_value'), '(CFixedPoint)0' )]"
						raw_text = "#low ~R#![GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_projected_rank_value')|0]"
					}

					using = tooltip_ne
					tooltipwidget = {
						widget = {
							using = DefaultTooltipBackground
							alwaystransparent = no

							vbox = {
								set_parent_size_to_minimum = yes
								margin = { 20 10 }
								spacing = 4

								text_label_left = {
									layoutpolicy_horizontal = expanding
									raw_text = "[Localize('tnt_ga_tt_title')]: [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_chance_value')|0]%"
									default_format = "#T"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									raw_text = "#low [Localize('tnt_ga_tt_weights')] [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_success_weight_value')|1] / [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_failure_weight_value')|1]#!"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "tnt_ga_tt_success_header"
									default_format = "#P"
								}
								widget_value_breakdown_list = {
									datacontext = "[GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).GetScriptValueBreakdown('tnt_ga_success_weight_value')]"
									blockoverride "background" {}
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "tnt_ga_tt_failure_header"
									default_format = "#N"
								}
								widget_value_breakdown_list = {
									datacontext = "[GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).GetScriptValueBreakdown('tnt_ga_failure_weight_value')]"
									blockoverride "background" {}
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_has_focus_value'), '(CFixedPoint)0' )]"
									raw_text = "[Localize('tnt_ga_tt_projection')] [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_current_points_value')|1] + [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_rolls_left_value')|0] x 2 x [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_chance_value')|0]% = #V [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_projected_points_value')|1]#! (~[Localize('tnt_ga_tt_rank')] [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_projected_rank_value')|0])"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[Not( GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_has_focus_value'), '(CFixedPoint)0' ) )]"
									text = "tnt_ga_tt_no_focus"
									default_format = "#low"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_storyteller_note_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_storyteller"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_beacon_note_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_beacon"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_note_pedagogy_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_pedagogy"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_note_commander_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_commander"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_note_knighthood_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_knighthood"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_note_faith_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_faith"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_note_culture_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_culture"
								}

								textbox = {
									layoutpolicy_horizontal = expanding
									margin_top = 4
									margin_bottom = 8
									max_width = 420
									autoresize = yes
									multiline = yes
									using = DefaultTooltipText
									text = "tnt_ga_tt_help"
									default_format = "#low"
								}
							}
						}
					}
				}

				# Vanilla, picking the secondary recipient: the other pair member is the secondary actor.
				hbox = {
					name = "tnt_ga_grade_b"
					min_height = 26
					spacing = 4
					alwaystransparent = no
					visible = "[And( And( CharacterInteractionConfirmationWindow.IsPickingSecondaryRecipient, Or( Or( EqualTo_string( CharacterInteractionConfirmationWindow.GetActorSecondaryLabel, Localize('actor_secondary_educate_child_interaction') ), EqualTo_string( CharacterInteractionConfirmationWindow.GetActorSecondaryLabel, Localize('actor_secondary_offer_guardianship_interaction') ) ), EqualTo_string( CharacterInteractionConfirmationWindow.GetRecipientSecondaryLabel, Localize('recipient_secondary_offer_ward_interaction') ) ) ), GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryActor.MakeScope ).ScriptValue('tnt_ga_available_value'), '(CFixedPoint)0' ) )]"

					text_single = {
						align = left|nobaseline
						using = Font_Size_Medium
						alwaystransparent = yes
						raw_text = "#low GCA#! [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryActor.MakeScope ).ScriptValue('tnt_ga_chance_value')|0]%"
					}
					text_single = {
						align = left|nobaseline
						using = Font_Size_Medium
						alwaystransparent = yes
						visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryActor.MakeScope ).ScriptValue('tnt_ga_has_focus_value'), '(CFixedPoint)0' )]"
