				# Vanilla, picking the secondary recipient: the other pair member is the secondary actor.
				hbox = {
					name = "tnt_ga_grade_b"
					# Only one trait icon is visible; hidden ones must not take space.
					ignoreinvisible = yes
					min_height = 26
					spacing = 4
					alwaystransparent = no
					visible = "[And( And( CharacterInteractionConfirmationWindow.IsPickingSecondaryRecipient, Or( Or( EqualTo_string( CharacterInteractionConfirmationWindow.GetActorSecondaryLabel, Localize('actor_secondary_educate_child_interaction') ), EqualTo_string( CharacterInteractionConfirmationWindow.GetActorSecondaryLabel, Localize('actor_secondary_offer_guardianship_interaction') ) ), EqualTo_string( CharacterInteractionConfirmationWindow.GetRecipientSecondaryLabel, Localize('recipient_secondary_offer_ward_interaction') ) ) ), GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryActor.MakeScope ).ScriptValue('tnt_ga_available_value'), '(CFixedPoint)0' ) )]"

					text_single = {
						align = left|nobaseline
						using = Font_Size_Medium
						alwaystransparent = yes
						raw_text = "#low GCA#! [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryActor.MakeScope ).ScriptValue('tnt_ga_chance_value')|0]%"
					}
					# Gap between the score and the trait icon.
					widget = {
						size = { 8 26 }
						alwaystransparent = yes
					}
					# University available at the guardian's ruler's realm. Fixed
					# footprint, so the trait icon never shifts.
					widget = {
						size = { 22 26 }
						alwaystransparent = yes
						icon = {
							visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryActor.MakeScope ).ScriptValue('tnt_ga_university_available_value'), '(CFixedPoint)0' )]"
							position = { 0 2 }
