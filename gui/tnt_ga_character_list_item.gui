								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_note_faith_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_faith"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_note_culture_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_culture"
								}

								textbox = {
									layoutpolicy_horizontal = expanding
									margin_top = 4
									margin_bottom = 8
									max_width = 420
									autoresize = yes
									multiline = yes
									using = DefaultTooltipText
									text = "tnt_ga_tt_help"
									default_format = "#low"
								}
							}
						}
					}
				}

				text_single = {
					name = "character_relation"
					layoutpolicy_horizontal = expanding
					raw_text = "|  [Character.GetRelationToString( GetPlayer )]"
					tooltip = "EXTENDED_RELATIONS_TOOLTIP"
					default_format = "#low"
					autoresize = no
					align = nobaseline
					visible = "[Character.HasRelationTo( GetPlayer )]"
					alwaystransparent = yes
				}

				expand = {
					visible = "[Not(Character.HasRelationTo( GetPlayer ))]"
				}
			}
		}
	}
}
