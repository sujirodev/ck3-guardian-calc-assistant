					text_single = {
						align = left|nobaseline
						using = Font_Size_Medium
						alwaystransparent = yes
						raw_text = "#low GCA#! [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_chance_value')|0]%"
