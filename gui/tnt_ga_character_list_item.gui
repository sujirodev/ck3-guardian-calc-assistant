				# GCA search: the row is a guardian candidate, the recipient is the ward.
				hbox = {
					name = "tnt_ga_grade_c"
					# Only one trait icon is visible; hidden ones must not take space.
					ignoreinvisible = yes
					min_height = 26
					spacing = 4
					alwaystransparent = no
					visible = "[And( And( CharacterInteractionConfirmationWindow.IsPickingSecondaryRecipient, EqualTo_string( CharacterInteractionConfirmationWindow.GetRecipientSecondaryLabel, Localize('recipient_secondary_tnt_ga_find_guardian_interaction') ) ), GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_available_value'), '(CFixedPoint)0' ) )]"

					text_single = {
						align = left|nobaseline
