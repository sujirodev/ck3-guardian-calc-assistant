						text = "DNA_MODIFIERS_LINK"

						fonttintcolor = "[TooltipInfo.GetTintColor]"

						tooltipwidget = {
							container = {
								name = "DnaModifierTooltip"
								alwaystransparent = no

								object_tooltip_pop_out = {
									blockoverride "header_additions"
									{
										hbox = {
											margin_right = 10
											margin_top = 8
											margin_left = -4

											button_copy = {
												size = { 52 52 }

												onclick = "[Character.CopyDnaAccessoryToClipboard]"
												raw_tooltip = "Copy DNA Modifiers"
											}
										}
									}

									blockoverride "title_text"
