											datacontext = "[GetTrait( 'education_learning_4' )]"
											position = { 0 0 }
											size = { 30 30 }
											texture = "[Trait.GetIcon( Character.Self )]"
										}
										}
										text_single = {
											align = nobaseline
											raw_text = "#V [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_odds_rank_4_univ_value')|0]%#!"
										}
									}
									hbox = {
										spacing = 4
										widget = {
											size = { 30 30 }
										icon = {
											visible = "[EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)1' )]"
											datacontext = "[GetTrait( 'education_diplomacy_5' )]"
											position = { 0 0 }
											size = { 30 30 }
											texture = "[Trait.GetIcon( Character.Self )]"
										}
										icon = {
											visible = "[EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)2' )]"
											datacontext = "[GetTrait( 'education_martial_5' )]"
											position = { 0 0 }
											size = { 30 30 }
											texture = "[Trait.GetIcon( Character.Self )]"
										}
										icon = {
											visible = "[EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)3' )]"
											datacontext = "[GetTrait( 'education_stewardship_5' )]"
											position = { 0 0 }
											size = { 30 30 }
											texture = "[Trait.GetIcon( Character.Self )]"
										}
										icon = {
											visible = "[EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)4' )]"
											datacontext = "[GetTrait( 'education_intrigue_5' )]"
											position = { 0 0 }
											size = { 30 30 }
											texture = "[Trait.GetIcon( Character.Self )]"
										}
										icon = {
											visible = "[EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)5' )]"
											datacontext = "[GetTrait( 'education_learning_5' )]"
											position = { 0 0 }
											size = { 30 30 }
											texture = "[Trait.GetIcon( Character.Self )]"
										}
										}
										text_single = {
											align = nobaseline
											raw_text = "#V [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_odds_rank_5_univ_value')|0]%#!"
										}
									}
									expand = {}
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[Not( GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_rank5_eligible_public_value'), '(CFixedPoint)0' ) )]"
									text = "tnt_ga_tt_rank5_locked"
									default_format = "#low"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[Not( GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_has_focus_value'), '(CFixedPoint)0' ) )]"
									raw_text = "#low [Localize('tnt_ga_tt_no_focus')] #V [Localize( Select_CString( EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)1' ), 'education_diplomacy', Select_CString( EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)2' ), 'education_martial', Select_CString( EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)3' ), 'education_stewardship', Select_CString( EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_effective_focus_public_value'), '(CFixedPoint)4' ), 'education_intrigue', 'education_learning' ) ) ) ) )]#!#!"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_storyteller_note_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_storyteller"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_beacon_note_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_beacon"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_note_pedagogy_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_pedagogy"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_note_commander_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_commander"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_note_knighthood_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_knighthood"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_note_faith_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_faith"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetRecipient.MakeScope ).ScriptValue('tnt_ga_note_culture_value'), '(CFixedPoint)0' )]"
									text = "tnt_ga_note_culture"
								}

								textbox = {
									layoutpolicy_horizontal = expanding
									margin_top = 4
									margin_bottom = 8
									max_width = 420
									autoresize = yes
									multiline = yes
									using = DefaultTooltipText
									text = "tnt_ga_tt_help"
									default_format = "#low"
								}
							}
						}
					}
				}

				text_single = {
					name = "character_relation"
					layoutpolicy_horizontal = expanding
					raw_text = "|  [Character.GetRelationToString( GetPlayer )]"
					tooltip = "EXTENDED_RELATIONS_TOOLTIP"
					default_format = "#low"
					autoresize = no
					align = nobaseline
					visible = "[Character.HasRelationTo( GetPlayer )]"
					alwaystransparent = yes
				}

				expand = {
					visible = "[Not(Character.HasRelationTo( GetPlayer ))]"
				}
			}
		}
	}
}

# Character tooltip with the GCA education block (generated into
# gui/shared/zz_tnt_ga_character_tooltip.gui by tools/gen_rows.py).
# Redefines the vanilla type cooltip_type from gui/shared/cooltip.gui
# (copied as is) and fills its empty extra_info block. Portrait tooltips
# instantiate cooltip_type directly, so this reaches them too. NOTE: at game
# start the vanilla definition is still used; this file only takes effect
# after a GUI hot reload. A full cooltip.gui override is needed to fix that.
types TntGaCharacterTooltip
{
	type cooltip_type = widget {
		name = "character_tooltip"
		alwaystransparent = no
		using = GeneralTooltipSetup

		widget = {
			name = "background"
			using = DefaultTooltipBackground
			size = { 100% 100% }
			alwaystransparent = no
			block "bg_visible" {
				visible = yes
			}
		}

		vbox = {
			set_parent_size_to_minimum = yes
			margin = { 15 15 }
			margin_top = 3
			maximumsize = { 600 -1 }

			## REAL CHARACTERS
			vbox = {
				visible = "[Character.IsValid]"
				layoutpolicy_horizontal = expanding

				vbox = {
					name = "personal"
					layoutpolicy_horizontal = expanding

					hbox = {
						layoutpolicy_horizontal = expanding

						vbox = {
							name = "name_etc"
							layoutpolicy_horizontal = expanding
							minimumsize = { 0 35 }

							## Name
							hbox = {
								layoutpolicy_horizontal = expanding
								margin_top = 8
								margin_right = 7

								background = {
									using = Background_Area
									margin = { 15 0 }
									margin_bottom = 7
								}

								vbox = {
									layoutpolicy_vertical = expanding
									margin_top = 3

									portrait_opinion = {
										visible = "[And( Character.IsAlive, Not( Character.IsPlayer ) )]"
									}

									expand = {}
								}

								spacer = {
									visible = "[And( Character.IsAlive, Not( Character.IsPlayer ) )]"
									size = { 8 5 }
								}

								text_multi = {
									name = "character_name"
									text = "CHARACTER_TT_NAME_AGE"
									default_format = "#high"
									using = Font_Size_Medium
									max_width = 350
									autoresize = yes
									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}

								vbox = {
									layoutpolicy_vertical = expanding
									margin_left = 5

									icon = {
										visible = "[Not(Character.IsDeadAndValid)]"
										size = { 23 23 }
										framesize = { 60 60 }
										frame = "[Character.GetHealthIconFrame]"
										texture = "gfx/interface/icons/character_status/icon_health.dds"
										tooltip = "[Character.GetHealthInfo]"
										color = "[TooltipInfo.GetTintColor]"
									}

									expand = {}
								}

								expand = {}
							}
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding

						text_multi = {
							name = "character_relation_to_you"
							margin_top = 10
							max_width = 308
							text = "[Character.GetRelationToString( GetPlayer )]"
							tooltip = "EXTENDED_RELATIONS_TOOLTIP"
							default_format = "#high"
							align = nobaseline
							autoresize = yes
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}

						expand = {}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 10
						margin_bottom = 10

						hbox = {
							name = "AI_personality"
							layoutpolicy_horizontal = expanding
							spacing = 2

							text_single = {
								visible = "[Not( Character.IsPlayer )]"
								text = "[Character.GetAIPersonalityNoTooltip]"
								default_format = "#L"
								tooltip = "AI_PERSONALITY_TT"
								align = nobaseline
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							hbox = {
								layoutpolicy_horizontal = expanding

								icon = {
									visible = "[Not(Character.IsFemale)]"
									size = { 20 20 }
									framesize = { 40 40 }
									frame = "[Character.GetSexualityFrame]"
									texture = "gfx/interface/icons/character_status/sexuality_icons_male.dds"
									tooltip = "SEXUALITY_TT"
									color = "[TooltipInfo.GetTintColor]"
								}

								icon = {
									visible = "[Character.IsFemale]"
									size = { 20 20 }
									framesize = { 40 40 }
									frame = "[Character.GetSexualityFrame]"
									texture = "gfx/interface/icons/character_status/sexuality_icons_female.dds"
									tooltip = "SEXUALITY_TT"
									color = "[TooltipInfo.GetTintColor]"
								}

								portrait_status_icons = {
									blockoverride "direction"
									{
										direction = horizontal
									}

									color = "[TooltipInfo.GetTintColor]"
								}

								expand = {}
							}

							expand = {}
						}

						hbox = {
							layoutpolicy_horizontal = expanding

							text_single = {
								visible = "[Character.IsAlive]"
								text = "[Character.Custom('CooltipSpouseListing')]"
								layoutpolicy_horizontal = expanding
								align = nobaseline
								max_width = 350
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}

							expand = {}
						}

						text_single = {
							visible = "[And( Character.IsAlive, Not( Character.IsImprisoned ) )]"
							layoutpolicy_horizontal = expanding
							text = "CHARACTER_LOCATION_TOOLTIP"
							align = nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"

						}

						text_single = {
							visible = "[And( Character.IsAlive, Character.IsImprisoned )]"
							layoutpolicy_horizontal = expanding
							text = "CHARACTER_IMPRISONED_TOOLTIP"
							align = nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}

						# for people with regnal names, like the pope
						text_single = {
							visible = "[Character.HasRegnalName]"
							layoutpolicy_horizontal	= expanding
							text = "CHARACTER_BIRTH_NAME_TOOLTIP"
							align = nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10

						background = {
							using = Background_Area
							margin = { 15 0 }
						}

						hbox = {
							name = "faith_and_culture"

							button_religion_icon = {
								name = "faith_button"
								datacontext = "[Character.GetFaith]"
								size = { 45 45 }
								color = "[TooltipInfo.GetTintColor]"
							}

							vbox = {
								margin_right = 10
								margin_left = 3

								text_single = {
									datacontext = "[Character.GetFaith]"
									layoutpolicy_horizontal = expanding
									text = "FAITH_COOLTIP_WINDOW"
									align = nobaseline

									tooltipwidget = { faith_tooltip_click = {} }

									button_normal = {
										size = { 100% 100% }
										onclick = "[OpenGameViewData( 'faith', Faith.GetID )]"
									}

									fonttintcolor = "[TooltipInfo.GetTintColor]"

								}

								text_single = {
									datacontext = "[Character.GetCulture]"
									layoutpolicy_horizontal = expanding
									text = "CULTURE_COOLTIP_WINDOW"
									align = nobaseline

									button_normal = {
										size = { 100% 100% }
										onclick = "[OpenGameViewData( 'culture_window', Culture.GetID )]"
										# shortcut = "innovations_window"
									}

									fonttintcolor = "[TooltipInfo.GetTintColor]"
								}
							}
						}

						hbox = {
							name = "house"
							datacontext = "[Character.GetHouse]"
							margin = { 10 5 }

							coa_house_small = {
								# has no effect, sadly...
								# color = "[TooltipInfo.GetTintColor]"

								container = {
									name = "characters_status_in_house"
									parentanchor = bottom|right

									icon = {
										name = "bastard"
										visible = "[Not(Character.IsLegitimateMemberOfHouse)]"
										framesize = { 40 40 }
										frame = 4
										size = { 25 25 }
										texture = "gfx/interface/icons/portraits/relation.dds"
										tooltip = "CV_TT_BASTARD"
										color = "[TooltipInfo.GetTintColor]"
									}

									icon = {
										name = "head_icon"
										size = { 20 20 }
										visible = "[LessThan_int32(Character.GetDynastyHeadRelationFrame('(bool)no'), '(int32)9')]"

										texture = "gfx/interface/icons/portraits/relation.dds"
										framesize = { 40 40 }
										frame = "[Character.GetDynastyHeadRelationFrame('(bool)no')]"
										tooltip = "[Character.GetDynastyHeadTooltip]"
										color = "[TooltipInfo.GetTintColor]"
									}
								}
							}

							text_multi = {
								visible = "[Character.HasDynasty]"
								margin = { 5 0 }
								text = "HOUSE_VIEW_NAME_WITH_HOUSE"
								max_width = 100
								autoresize = yes
								fonttintcolor = "[TooltipInfo.GetTintColor]"
							}
						}
					}
				}

				hbox = {
					visible = "[Character.HasLandedTitles]"
					minimumsize = { 0 82 }
					spacing = 5

					layoutpolicy_horizontal = expanding

					widget = {
						size = { 52 82 }

						coa_realm_small_crown = {
							name = "realm_flag"
							parentanchor = bottom

							blockoverride "coa_hover_glow_visible"
							{
								visible = no
							}
						}
					}

					realm_name_and_type_vbox = {
						datacontext = "[Character.GetPrimaryTitle]"
						margin_top = 24
					}
				}

				# GCA: education progress of a child with a guardian.
				block "extra_info" {
					# Debug mode only: shows that this tooltip type is the one in use,
					# with the guardian check, independent of the GCA block below.
					text_single = {
						visible = "[InDebugMode]"
						raw_text = "#low GCA tooltip (debug) | ward with guardian: [GuiScope.SetRoot( Character.MakeScope ).ScriptValue('tnt_ga_available_value')|0]#!"
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).ScriptValue('tnt_ga_available_value'), '(CFixedPoint)0' )]"
						ignoreinvisible = yes
						margin_top = 6
						spacing = 3

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "tnt_ga_ct_header"
							default_format = "#T"
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							raw_text = "[Localize('tnt_ga_ct_guardian')] [Character.GetRelationOfType('guardian').GetShortUINameNoTooltip] | #V [GuiScope.SetRoot( Character.MakeScope ).ScriptValue('tnt_ga_chance_value')|0]%#! [Localize('tnt_ga_ct_per_birthday')]"
						}
						text_single = {
							layoutpolicy_horizontal = expanding
