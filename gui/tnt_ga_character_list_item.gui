						raw_text = "#low ?#!"
					}

					using = tooltip_ne
					tooltipwidget = {
						widget = {
							using = DefaultTooltipBackground
							alwaystransparent = no

							vbox = {
								set_parent_size_to_minimum = yes
								ignoreinvisible = yes
								margin = { 20 10 }
								spacing = 4

								text_label_left = {
									layoutpolicy_horizontal = expanding
									raw_text = "[Localize('tnt_ga_tt_title')]: [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_chance_value')|0]%"
									default_format = "#T"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									raw_text = "#low [Localize('tnt_ga_tt_weights')] [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_success_weight_value')|1] / [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_failure_weight_value')|1]#!"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "tnt_ga_tt_success_header"
									default_format = "#P"
								}
								widget_value_breakdown_list = {
									datacontext = "[GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).GetScriptValueBreakdown('tnt_ga_success_weight_value')]"
									blockoverride "background" {}
								}

								text_single = {
