########################################################################
# Guardian Calculation Assistant 1.0
#
# Derived row for the generic interaction list. The vanilla/TC
# widget_character_list_item stays untouched; this type inherits whatever
# the playset supplies and only fills its character_relation block.
# Scores show only in Educate Child, Offer Guardianship, Offer Ward and
# the GCA guardian search, identified by their secondary-character
# labels, and only when the other slot holds the matching adult/child.
########################################################################

types TntGuardianAssistant
{
	type tnt_ga_widget_character_list_item = widget_character_list_item {
		blockoverride "character_relation" {
			hbox = {
				name = "tnt_ga_grade_and_relation"
				ignoreinvisible = yes
				layoutpolicy_horizontal = expanding
				min_height = 26
				spacing = 6

				# Vanilla, picking the secondary actor: the other pair member is the secondary recipient.
				hbox = {
					name = "tnt_ga_grade_a"
					# Only one trait icon is visible; hidden ones must not take space.
					ignoreinvisible = yes
					min_height = 26
					spacing = 4
					alwaystransparent = no
					visible = "[And( And( CharacterInteractionConfirmationWindow.IsPickingSecondaryActor, Or( Or( EqualTo_string( CharacterInteractionConfirmationWindow.GetActorSecondaryLabel, Localize('actor_secondary_educate_child_interaction') ), EqualTo_string( CharacterInteractionConfirmationWindow.GetActorSecondaryLabel, Localize('actor_secondary_offer_guardianship_interaction') ) ), EqualTo_string( CharacterInteractionConfirmationWindow.GetRecipientSecondaryLabel, Localize('recipient_secondary_offer_ward_interaction') ) ) ), GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_available_value'), '(CFixedPoint)0' ) )]"

					text_single = {
						align = left|nobaseline
						using = Font_Size_Medium
						alwaystransparent = yes
						raw_text = "#low GCA#! [GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_chance_value')|0]%"
					}
					# Gap between the score and the trait icon.
					widget = {
						size = { 8 26 }
						alwaystransparent = yes
					}
					# University available at the guardian's ruler's realm. Fixed
					# footprint, so the trait icon never shifts.
					widget = {
						size = { 22 26 }
						alwaystransparent = yes
						icon = {
							visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_university_available_value'), '(CFixedPoint)0' )]"
							position = { 0 2 }
							size = { 22 22 }
							alwaystransparent = yes
							texture = "gfx/interface/icons/building_types/icon_building_university.dds"
						}
					}
					# Projected education trait icon (one per trait; only the match shows).
					widget = {
						size = { 26 26 }
						alwaystransparent = yes
						icon = {
							visible = "[EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_projected_trait_value'), '(CFixedPoint)11' )]"
							datacontext = "[GetTrait( 'education_diplomacy_1' )]"
							position = { 0 0 }
							size = { 26 26 }
							alwaystransparent = yes
							texture = "[Trait.GetIcon( Character.Self )]"
						}
						icon = {
							visible = "[EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_projected_trait_value'), '(CFixedPoint)12' )]"
							datacontext = "[GetTrait( 'education_diplomacy_2' )]"
							position = { 0 0 }
							size = { 26 26 }
							alwaystransparent = yes
							texture = "[Trait.GetIcon( Character.Self )]"
						}
						icon = {
							visible = "[EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_projected_trait_value'), '(CFixedPoint)13' )]"
							datacontext = "[GetTrait( 'education_diplomacy_3' )]"
							position = { 0 0 }
							size = { 26 26 }
							alwaystransparent = yes
							texture = "[Trait.GetIcon( Character.Self )]"
						}
						icon = {
							visible = "[EqualTo_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'tnt_ga_other', CharacterInteractionConfirmationWindow.GetSecondaryRecipient.MakeScope ).ScriptValue('tnt_ga_projected_trait_value'), '(CFixedPoint)14' )]"
							datacontext = "[GetTrait( 'education_diplomacy_4' )]"
							position = { 0 0 }
							size = { 26 26 }
							alwaystransparent = yes
							texture = "[Trait.GetIcon( Character.Self )]"
						}
